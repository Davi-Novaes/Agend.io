# Copie para infra/.env e preencha. infra/.env nunca e commitado (ver .gitignore).
# Gerar segredo forte: openssl rand -base64 32

# --- Postgres ---
POSTGRES_SUPERUSER_PASSWORD=
AGENDIO_OWNER_PASSWORD=
AGENDIO_APP_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_PASSWORD=

# --- Assinatura JWT (32+ bytes cada, ver appsettings.Development.json) ---
JWT_SIGNING_KEY=
PLATFORM_JWT_SIGNING_KEY=
ONBOARDING_JWT_SIGNING_KEY=

# --- Criptografia de coluna (AES-256): exatamente 32 bytes em base64 ---
COLUMN_ENCRYPTION_KEY=

# --- Endereco publico ---
# Origem completa usada pelo backend (issuer JWT, CORS, link de e-mail) e como
# NEXT_PUBLIC_API_URL do frontend. TLS publica e roteamento de dominio sao
# trabalho do Cloudflare Tunnel (cloudflared roda no host, fora do compose) --
# o Caddy deste compose so escuta em localhost:80, sem TLS propria.
PUBLIC_ORIGIN=https://agendiobr.com.br

# --- Dominio raiz usado pra reconhecer subdominio de tenant (barber-teste.agendiobr.com.br) ---
# So precisa preencher se for diferente do host de PUBLIC_ORIGIN acima.
ROOT_DOMAIN=agendiobr.com.br

# --- Gateway de pagamento (Asaas) -- deixar em branco ate decidir sandbox/producao ---
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=
ASAAS_APPOINTMENT_DEPOSIT_WEBHOOK_SECRET=

# --- SMTP -- deixar em branco ate escolher um provedor real ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@agendiobr.com.br

# --- E-mail que recebe notificacao de feedback novo (alem do painel Super Admin) ---
FEEDBACK_NOTIFICATION_EMAIL=contato@agendiobr.com.br

# --- IA (Anthropic) -- deixar em branco ate decidir ---
AI_ASSISTANT_API_KEY=

# --- Cloudflare Turnstile (login/cadastro) ---
# Dashboard Cloudflare -> Security -> Turnstile -> Add widget (tipo Managed,
# dominio agendiobr.com.br) -- copia as duas chaves geradas. Em branco, usa a
# chave de teste publica da Cloudflare (sempre aprova, widget so decorativo).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
