NEXT_PUBLIC_API_URL=http://localhost:5071

# Dominio raiz usado pelo proxy.ts para reconhecer subdominio de tenant
# (barber-teste.agendiobr.com.br) e pelo cliente de API pra decidir quando
# chamar a mesma origem em vez de NEXT_PUBLIC_API_URL. So importa em
# producao -- em localhost nunca bate, e a pagina publica continua
# funcionando por path (/barber-teste).
NEXT_PUBLIC_ROOT_DOMAIN=agendiobr.com.br
