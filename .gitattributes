# Normaliza fim de linha: LF no repositorio, nativo no working tree.
* text=auto

*.cs        text diff=csharp
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.props     text
*.targets   text
*.json      text
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.ps1       text eol=crlf
*.md        text
*.sql       text eol=lf
Dockerfile  text eol=lf

*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.pdf       binary
