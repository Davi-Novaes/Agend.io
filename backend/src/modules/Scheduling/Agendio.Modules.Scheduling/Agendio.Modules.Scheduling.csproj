<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tipos de Minimal API (IEndpointRouteBuilder, Results) usados em Endpoints/. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!-- Npgsql.PostgresException: traduz a violacao da EXCLUDE constraint (23P01) em erro de negocio. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- IBackgroundJobClient: enfileira confirmacao/lembrete (Sprint 5). -->
    <PackageReference Include="Hangfire.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\Agendio.SharedKernel\Agendio.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\shared\Agendio.Infrastructure\Agendio.Infrastructure.csproj" />
    <!-- Comunicacao entre modulos so via .Contracts (leitura sincrona) — nunca o modulo inteiro. -->
    <ProjectReference Include="..\..\Customers\Agendio.Modules.Customers.Contracts\Agendio.Modules.Customers.Contracts.csproj" />
    <ProjectReference Include="..\..\Catalog\Agendio.Modules.Catalog.Contracts\Agendio.Modules.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\..\Resources\Agendio.Modules.Resources.Contracts\Agendio.Modules.Resources.Contracts.csproj" />
    <ProjectReference Include="..\..\Tenancy\Agendio.Modules.Tenancy.Contracts\Agendio.Modules.Tenancy.Contracts.csproj" />
  </ItemGroup>

</Project>
