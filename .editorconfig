root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,config,nuspec}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ts,tsx,js,jsx,json,jsonc,css,yml,yaml}]
indent_size = 2

# ============================================================
# Convencoes C#
# ============================================================
[*.cs]

# --- using ---
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# --- namespace com escopo de arquivo (menos aninhamento) ---
csharp_style_namespace_declarations = file_scoped:warning

# --- var: explicito quando o tipo nao e obvio ---
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# --- expression-bodied members ---
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion

# --- padroes modernos ---
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_throw_expression = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_collection_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion

# --- chaves sempre, mesmo em uma linha (evita bug de indentacao) ---
csharp_prefer_braces = true:warning

# --- imutabilidade ---
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:suggestion

# --- this. desnecessario ---
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# --- nomenclatura ---
dotnet_naming_rule.interfaces_prefixed_with_i.severity = warning
dotnet_naming_rule.interfaces_prefixed_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_prefixed_with_i.style = i_prefix_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.i_prefix_style.required_prefix = I
dotnet_naming_style.i_prefix_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constant_symbol
dotnet_naming_rule.constants_pascal.style = pascal_style
dotnet_naming_symbols.constant_symbol.applicable_kinds = field
dotnet_naming_symbols.constant_symbol.required_modifiers = const
dotnet_naming_style.pascal_style.capitalization = pascal_case

# ============================================================
# Severidade de analisadores
# ============================================================

# CA1848 (LoggerMessage delegates) e util mas ruidoso em codigo de aplicacao.
dotnet_diagnostic.CA1848.severity = none
# CA1031 (nao capturar Exception generica) - controlamos isso em code review.
dotnet_diagnostic.CA1031.severity = none
# CA2007 (ConfigureAwait) nao se aplica a ASP.NET Core (sem SynchronizationContext).
dotnet_diagnostic.CA2007.severity = none
# CA1062 - validacao de argumento publico; nullable reference types ja cobre.
dotnet_diagnostic.CA1062.severity = none
# CA1716 - "Error" e "next" colidem com palavra reservada em outras linguagens .NET
# (Error = VB.NET, Next = VB.NET/F#). Sao os nomes idiomaticos do Result pattern e
# de middleware pipeline; renomear prejudica legibilidade sem beneficio real, ja
# que o projeto nao visa consumo por VB.NET/F#.
dotnet_diagnostic.CA1716.severity = none
# CA1873 - sinaliza qualquer argumento de log que nao seja literal/campo simples
# como "potencialmente caro", mesmo sendo um getter trivial (ex.: Stopwatch.
# ElapsedMilliseconds, uma propriedade de string). Ja usamos templates
# estruturados (nunca interpolacao de string) em todo log — o formato so e
# processado se o sink aceitar o nivel, entao o ganho de exigir IsEnabled()
# em cada chamada nao compensa a ceremonia.
dotnet_diagnostic.CA1873.severity = none

# Erros que NAO toleramos:
# CA2100 - SQL vulneravel a injecao.
dotnet_diagnostic.CA2100.severity = error
# CA5350/CA5351 - algoritmos criptograficos fracos.
dotnet_diagnostic.CA5350.severity = error
dotnet_diagnostic.CA5351.severity = error
# CA2016 - propagar CancellationToken.
dotnet_diagnostic.CA2016.severity = error
# CA1305/CA1310 - cultura explicita em formatacao e comparacao de string.
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1310.severity = warning

# Testes: regras de nomenclatura e design nao se aplicam do mesmo jeito.
[backend/tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
# CA1711 - a convencao do xUnit para marcador de ICollectionFixture e literalmente
# "NomeCollection : ICollectionFixture<T>"; seguir a convencao da propria
# ferramenta de teste nao e um problema a corrigir.
dotnet_diagnostic.CA1711.severity = none

# Migrations sao geradas pelo `dotnet ef` — nao seguem (nem deveriam seguir) as
# convencoes de estilo do resto do codigo escrito a mao.
[**/Migrations/*.cs]
csharp_style_namespace_declarations = block_scoped:silent
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CA1861.severity = none
